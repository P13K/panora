{
  "_readme": "All screener settings live here. Edit this file, not the code. Then rerun build_universe.py followed by screener.py.",

  "universe": {
    "markets": ["XPAR", "XAMS", "XBRU", "XLIS"],
    "eligible_countries": ["FR","NL","BE","PT","DE","ES","IT","IE","LU","AT","FI","SE","DK","PL","GR","CZ","HU","RO","BG","HR","SI","SK","EE","LV","LT","CY","MT","NO","IS","LI"],
    "min_market_cap_eur": 50000000,
    "min_daily_turnover_eur": 100000,
    "exclude_tickers": ["NOKIA.PA", "MT.AS"],
    "_comment_exclusions": "Duplicate listings or names you never want resurfacing."
  },

  "elimination_filters": {
    "enabled": true,
    "max_days_below_ma200": 126,
    "net_income_must_be_positive": true,
    "fcf_must_be_positive": true,
    "max_net_debt_to_ebitda": 5.0,
    "min_current_ratio": 0.8,
    "min_revenue_growth_3y": -0.03,
    "sectors_exempt_from_debt_filter": ["Real Estate", "Utilities", "Financial Services"],
    "_comment": "A stock that trips even one of these filters is flagged 'excluded'. Set 'enabled' to false to see the full universe unfiltered."
  },

  "score_weights": {
    "trend": 0.40,
    "quality": 0.25,
    "growth": 0.20,
    "value": 0.15
  },

  "trend_grid": {
    "great_52w_perf": 0.25,
    "good_52w_perf": 0.10,
    "great_relative_strength": 0.15,
    "min_ma200_slope": 0.0
  },

  "quality_grid": {
    "excellent_roe": 0.25,
    "good_roe": 0.15,
    "fair_roe": 0.10,
    "weak_roe": 0.05,
    "excellent_debt_to_ebitda": 1.0,
    "acceptable_debt_to_ebitda": 3.0,
    "excellent_fcf_yield": 0.05
  },

  "growth_grid": {
    "great_revenue_growth": 0.20,
    "good_revenue_growth": 0.10,
    "fair_revenue_growth": 0.05
  },

  "value_grid": {
    "excellent_pe": 12,
    "good_pe": 18,
    "fair_pe": 25,
    "high_pe": 35,
    "excellent_fcf_yield": 0.07,
    "good_fcf_yield": 0.04,
    "excellent_ev_ebitda": 8
  },

  "half_price_5y_valuation": {
    "target_cagr": 0.15,
    "eps_growth_cap": 0.20,
    "eps_growth_default": 0.08,
    "exit_pe_cap": 20,
    "_comment": "EPS projected 5 years out with capped growth, exit PE capped, then implied CAGR back to today's price."
  },

  "display_thresholds": {
    "shortlist_score": 3.8,
    "min_insider_ownership": 0.03,
    "min_roe": 0.15,
    "target_roce": 0.15,
    "max_peg": 1.0,
    "max_ev_ebitda": 10,
    "min_eps_growth": 0.05,
    "max_debt_to_ebitda": 2.0,
    "max_debt_to_net_income": 4.0,
    "_comment": "Quality thresholds used only for the green/red pills in the detail panel. They do not exclude anything."
  },

  "execution": {
    "benchmark": "^STOXX",
    "benchmark_fallback": "^FCHI",
    "pause_between_calls_sec": 0.5,
    "fundamentals_only_if_trend_passes": true,
    "_comment_perf": "fundamentals_only_if_trend_passes = true: fundamentals are only downloaded for stocks that already passed the trend filter. Roughly cuts run time by 3x on a large universe."
  }
}
